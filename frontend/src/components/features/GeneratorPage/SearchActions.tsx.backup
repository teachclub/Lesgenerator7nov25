import React from "react";
import { Loader2, X } from "lucide-react"; // lucide-react is oké

type SearchActionsProps = {
  onSearch?: () => void;
  isSearching?: boolean;
  disabled?: boolean;
};

const SearchActions: React.FC<SearchActionsProps> = ({
  onSearch,
  isSearching = false,
  disabled = false,
}) => {
  const handleClick = () => {
    if (disabled) return;
    if (onSearch) {
      onSearch();
    }
  };

  return (
    <div className="mt-4 flex items-center gap-3">
      <button
        type="button"
        onClick={handleClick}
        disabled={disabled || isSearching}
        className="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed"
      >
        {isSearching ? "Zoeken..." : "Zoek bronnen"}
      </button>
    </div>
  );
};

export default SearchActions;
export { SearchActions };
